# Public values: provide during build AND at runtime.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only: runtime secret, never a Docker build argument.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Your actual deployed HTTPS origin; alternatively configure it in Workflow delivery.
NEXT_PUBLIC_APP_URL=https://YOUR_DEPLOYED_DOMAIN
PORT=3000
